# =============================================================================
#  CALIPE DIGITAL — Variáveis de Ambiente
#  Copie este ficheiro para .env e ajuste os valores.
#  NUNCA commite o .env com credenciais reais.
# =============================================================================

# ── Base de Dados ────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=calipe_digital
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── JWT ──────────────────────────────────────────────────────────────────────
# Gere uma chave forte: openssl rand -hex 64
JWT_SECRET=MUDE_ESTA_CHAVE_PARA_PRODUCAO_openssl_rand_hex_64
JWT_EXPIRATION=86400

# ── Upload de Imagens ────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880    # 5 MB em bytes
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# ── CORS ─────────────────────────────────────────────────────────────────────
# Em desenvolvimento: http://localhost:5173
# Em produção: https://seudominio.com
ALLOWED_ORIGIN=http://localhost:5173

# ── Ambiente ─────────────────────────────────────────────────────────────────
APP_ENV=development    # development | production
APP_DEBUG=true         # false em produção
